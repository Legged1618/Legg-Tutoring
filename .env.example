# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys, and Developers > Webhooks for the signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Your email, used to recognize you (the tutor) vs. clients when cancelling a
# session, and where new-consultation notifications are sent.
TUTOR_EMAIL=ed@leggtutoring.com

# Resend (Developers > API Keys at resend.com) -- sends the consultation
# confirmation to clients and the "what to do" notice to you.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, or leave unset to use
# their shared onboarding.resend.dev sender while testing.
EMAIL_FROM="Legg Tutoring <onboarding@resend.dev>"

# Link to the finalized call script (e.g. your Claude Docs doc, once
# shared, or a Google Doc) -- included in the tutor notification email.
CALL_SCRIPT_URL=
